{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-scope-guard.sh\" ] || \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-scope-guard.sh\""
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/preflight-guard.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
