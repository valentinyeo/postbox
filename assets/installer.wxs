<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Postbox"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Postbox"
           UpgradeCode="E2C53374-5665-593B-94F8-38573F3164D2">
    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perUser"
             Description="Postbox installer"
             Manufacturer="Postbox" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Postbox is already installed." />
    <Media Id="1" Cabinet="messages.cab" EmbedCab="yes" />
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Messages" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MessagesExe" Guid="4FC6E44E-17A5-5F45-958F-020449338BFF">
        <File Id="MessagesExeFile" Name="Messages.exe" Source="$(var.BinDir)Messages.exe" KeyPath="yes" />
      </Component>
      <Component Id="WazigCtlExe" Guid="6EF4C9CC-392A-4939-AC20-1770B9E15633">
        <File Id="WazigCtlExeFile" Name="wazigctl.exe" Source="$(var.BinDir)wazigctl.exe" KeyPath="yes" />
      </Component>
      <Component Id="PostboxCtlExe" Guid="0775341F-9661-48BA-93CD-6254EF517E53">
        <File Id="PostboxCtlExeFile" Name="postboxctl.exe" Source="$(var.BinDir)postboxctl.exe" KeyPath="yes" />
      </Component>
      <Component Id="PlexItalic" Guid="9c04ebc4-6aeb-4fb8-b0e9-a4bbfa1b5892">
        <File Id="PlexItalicFile" Name="IBMPlexSans-Italic.ttf" Source="$(var.BinDir)IBMPlexSans-Italic.ttf" KeyPath="yes" />
      </Component>
      <Component Id="PlexMono" Guid="555a0af5-e3c7-456c-a593-68b48c10c9d3">
        <File Id="PlexMonoFile" Name="IBMPlexMono-Regular.ttf" Source="$(var.BinDir)IBMPlexMono-Regular.ttf" KeyPath="yes" />
      </Component>
      <Component Id="PlexRegular" Guid="1A96D346-DF77-5C8D-AF3B-857F10E50DFF">
        <File Id="PlexRegularFile" Name="IBMPlexSans-Regular.ttf" Source="$(var.BinDir)IBMPlexSans-Regular.ttf" KeyPath="yes" />
      </Component>
      <Component Id="PlexMedium" Guid="6C5075B7-AB0D-4BBE-A823-911F0ACED023">
        <File Id="PlexMediumFile" Name="IBMPlexSans-Medium.ttf" Source="$(var.BinDir)IBMPlexSans-Medium.ttf" KeyPath="yes" />
      </Component>
      <Component Id="PlexBold" Guid="7C3FE2DF-B02E-432B-9AF5-45B0919D1566">
        <File Id="PlexBoldFile" Name="IBMPlexSans-Bold.ttf" Source="$(var.BinDir)IBMPlexSans-Bold.ttf" KeyPath="yes" />
      </Component>
      <Component Id="PlexSemiBold" Guid="E8332C91-8C69-5F65-8A73-FA273D2713CE">
        <File Id="PlexSemiBoldFile" Name="IBMPlexSans-SemiBold.ttf" Source="$(var.BinDir)IBMPlexSans-SemiBold.ttf" KeyPath="yes" />
      </Component>
      <Component Id="PlexLicense" Guid="FC9F0507-8A60-5970-B349-BC675F7C44D5">
        <File Id="PlexLicenseFile" Name="IBM-Plex-LICENSE.txt" Source="$(var.BinDir)IBM-Plex-LICENSE.txt" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="29415F78-0826-52C8-9F9D-2457573E2144">
        <RegistryValue Root="HKCU" Key="Software\Wazig\Messages"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="MessagesShortcut"
                  Name="Postbox"
                  Description="Postbox"
                  Target="[INSTALLDIR]Messages.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Postbox" Level="1">
      <ComponentRef Id="MessagesExe" />
      <ComponentRef Id="WazigCtlExe" />
      <ComponentRef Id="PostboxCtlExe" />
      <ComponentRef Id="PlexItalic" />
      <ComponentRef Id="PlexMono" />
      <ComponentRef Id="PlexRegular" />
      <ComponentRef Id="PlexMedium" />
      <ComponentRef Id="PlexSemiBold" />
      <ComponentRef Id="PlexBold" />
      <ComponentRef Id="PlexLicense" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
